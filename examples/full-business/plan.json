{"packages": ["curl", "python3"], "files": [{"src": "files/app.conf", "dest": "/etc/app.conf", "contains": "migrated", "owner": "appsvc", "group": "appsvc", "mode": "0640"}], "dirs": [{"src": "server", "dest": "/server", "owner": "appsvc", "group": "appsvc", "attrs": [{"path": "bin/app.sh", "mode": "0755", "owner": "appsvc", "group": "appsvc"}, {"path": "config/app.env", "mode": "0640", "owner": "appsvc", "group": "appsvc"}, {"path": "secrets/db.key", "mode": "0600", "owner": "appsvc", "group": "appsvc"}, {"path": "web/index.html", "mode": "0644", "owner": "appsvc", "group": "appsvc"}]}], "units": [{"src": "units/app.service", "name": "app.service", "dest": "/etc/systemd/system/app.service"}], "services": [{"name": "app", "start": "cd /server/web && python3 -m http.server 8080 --bind 0.0.0.0", "stop": "pkill -f 'http.server 8080'", "port": 8080, "wait": 6}], "groups": ["appsvc"], "users": [{"name": "appsvc", "group": "appsvc"}], "cron": [{"expr": "*/10 * * * *", "cmd": "/server/bin/app.sh"}], "commands": ["curl", "python3"], "checks": [{"name": "app-http", "cmd": "curl -s -m 3 -o /dev/null http://127.0.0.1:8080/"}, {"name": "key-perm", "cmd": "test \"$(stat -c '%a' /server/secrets/db.key)\" = 600"}], "firewall": {"backend": "auto", "allow_tcp": [8080], "allow_udp": [], "default_input": "deny"}, "per_distro": {}}
