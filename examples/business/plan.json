{
  "src_root": "out/proxysss-stack",
  "packages": ["curl"],
  "dirs": [
    { "src": "server", "dest": "/server" }
  ],
  "units": [
    { "src": "files/proxysss.service", "name": "proxysss.service", "dest": "/etc/systemd/system/proxysss.service" }
  ],
  "services": [
    {
      "name": "proxysss",
      "start": "cd /server/proxysss && ./proxysss run -c proxysss.yaml",
      "stop": "pkill -f 'proxysss run'",
      "port": 8080,
      "wait": 8
    }
  ],
  "checks": [
    { "name": "binary-exec", "cmd": "/server/proxysss/proxysss --version" },
    { "name": "config-valid", "cmd": "cd /server/proxysss && ./proxysss check-config -c proxysss.yaml" },
    { "name": "static-site", "cmd": "curl -sf http://127.0.0.1:8080/ | grep -q 'proxysss business ok'" },
    { "name": "admin-7777", "cmd": "awk -v pat='1E61' 'FNR>1{split($2,a,\":\"); if(toupper(a[2])==pat && $4==\"0A\") f=1} END{exit !f}' /proc/net/tcp" }
  ]
}
